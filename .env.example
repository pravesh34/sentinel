# SENTINEL — copy to .env, never commit real keys. Docker reads this via docker-compose.yml env vars.
SECRET_KEY=dev-secret-change-me-32chars-long!!
ENCRYPTION_KEY=  # optional Fernet key; derived from SECRET_KEY if empty (set in prod!)

# --- Option A (recommended, per-user): add keys in Dashboard "API Keys" or via POST /api/v1/auth/credentials.
#     Keys are Fernet-encrypted at rest, never returned by the API, and resolved per execution.

# --- Option B (server fallback): single set of keys for all users
DEFAULT_PROVIDER=mock   # mock|openai|groq|anthropic|google
DEFAULT_MODEL=mock-llm-1
FALLBACK_PROVIDER=      # e.g. groq — tried if primary provider fails
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=         # for live web_search (optional)

DATABASE_URL=sqlite:///./sentinel.db   # prod: postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://localhost:6379/0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel
NEXT_PUBLIC_API_URL=http://localhost:8000
