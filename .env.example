# SENTINEL — copy to .env, never commit real keys
SECRET_KEY=dev-secret-change-me-32chars-long!!
ENCRYPTION_KEY=  # optional Fernet key; derived from SECRET_KEY if empty
DATABASE_URL=sqlite:///./sentinel.db   # prod: postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://localhost:6379/0
DEFAULT_PROVIDER=mock   # mock|openai|google|groq|anthropic
DEFAULT_MODEL=mock-llm-1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel
NEXT_PUBLIC_API_URL=http://localhost:8000
# Real provider keys (stored per-user encrypted via /auth/credentials in prod UI):
# OPENAI_API_KEY= / GEMINI_API_KEY= / GROQ_API_KEY= / ANTHROPIC_API_KEY=
